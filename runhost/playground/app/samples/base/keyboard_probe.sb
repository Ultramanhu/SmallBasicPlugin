GraphicsWindow.Title = "Keyboard Probe"
GraphicsWindow.Width = 800
GraphicsWindow.Height = 240
GraphicsWindow.DrawText(20, 20, "Click the graphics window, then press keys.")
GraphicsWindow.DrawText(20, 50, "Expected: TextWindow prints KEY=<LastKey>; TEXT=<LastText>")
GraphicsWindow.KeyDown = HandleKey

While "True"
  Program.Delay(50)
EndWhile

Sub HandleKey
  TextWindow.WriteLine("KEY=" + GraphicsWindow.LastKey + "; TEXT=" + GraphicsWindow.LastText)
EndSub
