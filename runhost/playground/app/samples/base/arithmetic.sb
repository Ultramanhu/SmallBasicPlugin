TextWindow.WriteLine(Math.Div(9, 0))
TextWindow.WriteLine(Math.Mod(9, 0))

Function DigitSum(Number)
  Dim Sum
  Sum = 0
  While Number > 0
    Sum = Sum + Number Mod 10
    Number = Number \ 10
  EndWhile
  Return Sum
EndFunction

TextWindow.WriteLine(DigitSum(1234))
