    ],
    "runtimeError": {
      "code": 1001,
      "message": "Divide by zero."
    }
  },
  {
    "name": "On Error GoSub fires again for each error after the handler returns",
    "source": [
      "On Error GoSub Handler",
      "X = 1 / 0",
      "Y = 2 Mod 0",
      "TextWindow.WriteLine(\"done\")",
      "",
      "Sub Handler(Code, Message)",
      "  Count = Count + 1",
      "  TextWindow.WriteLine(\"hit\" + Count)",
      "EndSub"
    ],
    "stdout": [
      "[Runtime Error] 1001: Divide by zero.",
      "hit1",
      "[Runtime Error] 1001: Divide by zero.",
      "hit2",
      "done"
    ],
    "globals": {
      "Count": "2"
    }
  },
