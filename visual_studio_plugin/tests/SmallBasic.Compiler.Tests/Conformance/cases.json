  {
    "name": "recursive frames",
    "source": [
      "Function Factorial(N)",
      "  If N <= 1 Then",
      "    Return 1",
      "  EndIf",
      "  Return N * Factorial(N - 1)",
      "EndFunction",
      "Answer = Factorial(6)"
    ],
    "stdout": [],
    "globals": {
      "Answer": "720"
    }
  },
  {
    "name": "parameter and Dim shadow globals",
    "source": [
      "Value = 100",
      "Local = 200",
      "Function Calculate(Value)",
      "  Dim Local",
      "  Local = Value + 1",
      "  Return Local",
      "EndFunction",
      "Answer = Calculate(4)"
    ],
    "stdout": [],
    "globals": {
      "Value": "100",
      "Local": "200",
      "Answer": "5"
    }
  },
  {
    "name": "same local name belongs to separate procedures",
    "source": [
      "Function One()",
      "  Dim Temporary",
      "  Temporary = 1",
      "  Return Temporary",
      "EndFunction",
      "Function Two()",
      "  Dim Temporary",
      "  Temporary = 2",
      "  Return Temporary",
      "EndFunction",
      "First = One()",
      "Second = Two()"
    ],
    "stdout": [],
    "globals": {
      "First": "1",
      "Second": "2"
    }
  },
  {
    "name": "return exits nested control flow",
    "source": [
      "Function FindThird()",
      "  Dim Index",
      "  Index = 0",
      "  While Index < 5",
      "    Index = Index + 1",
      "    If Index = 3 Then",
      "      Return Index",
      "    EndIf",
      "  EndWhile",
      "  Return 0",
      "EndFunction",
      "Answer = FindThird()"
    ],
    "stdout": [],
    "globals": {
      "Answer": "3"
    }
  },
  {
    "name": "array parameter has ByVal reference semantics",
    "source": [
      "Function Change(Item)",
      "  Item[\"changed\"] = \"yes\"",
      "  Item = \"replacement\"",
      "  Return Item",
      "EndFunction",
      "Source[\"initial\"] = \"value\"",
      "Returned = Change(Source)",
      "TextWindow.WriteLine(Returned)",
      "TextWindow.WriteLine(Source[\"changed\"])"
    ],
    "stdout": [
      "replacement",
      "yes"
    ],
    "globals": {
      "Returned": "replacement"
    }
  },
