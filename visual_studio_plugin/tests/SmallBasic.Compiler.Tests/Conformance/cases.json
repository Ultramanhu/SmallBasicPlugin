  {
    "name": "Break and Continue only affect the innermost loop",
    "source": [
      "Out = 0",
      "For I = 1 To 2",
      "  For J = 1 To 3",
      "    If J = 2 Then",
      "      Continue",
      "    EndIf",
      "    If J = 3 Then",
      "      Break",
      "    EndIf",
      "    Out = Out + I * 10 + J",
      "  EndFor",
      "  Out = Out + 1000",
      "EndFor",
      "TextWindow.WriteLine(Out)"
    ],
    "stdout": [
      "2032"
    ],
    "globals": {
      "Out": "2032",
      "I": "3",
      "J": "3"
    }
