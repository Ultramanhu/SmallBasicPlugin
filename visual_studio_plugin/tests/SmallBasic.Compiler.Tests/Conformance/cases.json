      "For I = 1 To 5",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Sum = Sum + I",
      "EndFor",
      "TextWindow.WriteLine(Sum)",
      "TextWindow.WriteLine(I)"
    ],
    "stdout": [
      "12",
      "6"
    ],
    "globals": {
      "Sum": "12",
      "I": "6"
    }
  },
