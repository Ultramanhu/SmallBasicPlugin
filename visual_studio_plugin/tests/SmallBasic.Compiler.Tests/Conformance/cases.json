  {
    "name": "Break exits the innermost While loop",
    "source": [
      "While \"True\"",
      "  TextWindow.WriteLine(\"before\")",
      "  Break",
      "  TextWindow.WriteLine(\"after\")",
      "EndWhile",
      "TextWindow.WriteLine(\"done\")"
    ],
    "stdout": [
      "before",
      "done"
    ]
  },
  {
    "name": "Continue skips the rest of the While body",
    "source": [
      "I = 0",
      "Sum = 0",
      "While I < 5",
      "  I = I + 1",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Sum = Sum + I",
      "EndWhile",
      "TextWindow.WriteLine(Sum)"
    ],
    "stdout": [
      "12"
    ],
    "globals": {
      "Sum": "12",
      "I": "5"
    }
  },
  {
    "name": "Break in a For loop skips the increment",
    "source": [
      "For I = 1 To 10",
      "  If I = 4 Then",
      "    Break",
      "  EndIf",
      "EndFor",
      "TextWindow.WriteLine(I)"
    ],
    "stdout": [
