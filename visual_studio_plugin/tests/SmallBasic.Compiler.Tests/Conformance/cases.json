  {
    "name": "On Error GoSub Handler receives the code and message and resumes",
    "source": [
      "On Error GoSub Handler",
      "TextWindow.WriteLine(\"before\")",
      "X = 1 / 0",
      "TextWindow.WriteLine(\"after\")",
      "",
      "Sub Handler(Code, Message)",
      "  TextWindow.WriteLine(\"ERR=\" + Code)",
      "  TextWindow.WriteLine(Message)",
      "EndSub"
    ],
    "stdout": [
      "before",
      "[Runtime Error] 1001: Divide by zero.",
      "ERR=1001",
      "Divide by zero.",
      "after"
    ],
    "globals": {}
  },
  {
    "name": "On Error GoTo 0 clears the handler and restores termination",
    "source": [
      "On Error GoSub Handler",
      "On Error GoTo 0",
      "TextWindow.WriteLine(1 / 0)",
      "",
      "Sub Handler(Code, Message)",
      "  TextWindow.WriteLine(\"ERR=\" + Code)",
      "EndSub"
    ],
    "stdout": [],
    "runtimeError": {
      "code": 1001,
      "message": "Divide by zero."
    }
  },
  {
    "name": "On Error GoTo -1 restores the default termination",
    "source": [
      "On Error Resume Next",
      "A = 1 / 0",
      "On Error GoTo -1",
      "TextWindow.WriteLine(1 / 0)"
    ],
    "stdout": [
