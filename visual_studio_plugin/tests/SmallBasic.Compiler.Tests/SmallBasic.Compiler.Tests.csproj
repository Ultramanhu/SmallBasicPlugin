<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmallBasic.RunHost\SmallBasic.RunHost.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Compiler\SmallBasic.Compiler.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Utilities\SmallBasic.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="xunit.analyzers" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestExtensions.cs" />
    <Compile Include="Editor\SmallBasicOutlineTests.cs" />
    <Compile Include="Runtime\**\*.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\CultureFixture.cs" Link="CultureFixture.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\LoggingTestLibraries.Generated.cs" Link="LoggingTestLibraries.Generated.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Compiler\**\*.cs" Link="Compiler\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Runtime\**\*.cs" Link="Runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared conformance corpus (language extension + unified runtime
         semantics) lives inside this test project; the TypeScript runner
         (smallbasic-lang-core) reads the very same file. -->
    <Content Include="Conformance\cases.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
