<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The language layer targets netstandard2.0 precisely so the net8.0 tests can
         reference the very same assembly the extension loads, instead of
         link-compiling its sources a second time. -->
    <ProjectReference Include="..\..\src\SmallBasic.LanguageServices\SmallBasic.LanguageServices.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Compiler\SmallBasic.Compiler.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Utilities\SmallBasic.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="xunit.analyzers" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\CultureFixture.cs"
             Link="CultureFixture.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Services\CompletionItemProviderTests.cs"
             Link="CompilerServices\CompletionItemProviderTests.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Services\HoverProviderTests.cs"
             Link="CompilerServices\HoverProviderTests.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Tests\Services\SignatureHelpProviderTests.cs"
             Link="CompilerServices\SignatureHelpProviderTests.cs" />
  </ItemGroup>
</Project>
