<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'x86'">AnyCPU</Platform>
    <Platforms>AnyCPU</Platforms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <!-- Let VSSDK BuildTools create the complete VSIX v3 package, including
         manifest.json, catalog.json, extensionDir, hashes and dependencies. -->
    <CreateVsixContainer>true</CreateVsixContainer>
    <TargetVsixContainerName>SmallBasic.Vsix.vsix</TargetVsixContainerName>
    <DeployExtension>false</DeployExtension>
    <CopyVsixManifestToOutput>true</CopyVsixManifestToOutput>
    <DebugAdapterSource>$(MSBuildThisFileDirectory)..\..\..\visual_studio_code_plugin\packages\smallbasic-vscode\dist\debug\adapter.js</DebugAdapterSource>
    <JavaScriptRunHostSource>$(MSBuildThisFileDirectory)..\..\..\visual_studio_code_plugin\packages\smallbasic-vscode\dist\runhost.js</JavaScriptRunHostSource>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/RootSuffix Exp</StartArguments>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The extension version is owned by <repo>/version.json and propagated by
         tools/sync-version.mjs, which this project runs before every build. -->
    <RepoRootDirectory>$(MSBuildThisFileDirectory)..\..\..\</RepoRootDirectory>
    <VersionSyncScript>$(RepoRootDirectory)tools\sync-version.mjs</VersionSyncScript>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.11.40262" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
    <!-- Open Folder launch-target extensibility. The assembly keeps a stable
         17.0.0.0 version and Visual Studio ships it in every installation, so
         the reference is compile-only (runtime assets excluded). -->
    <PackageReference Include="Microsoft.VisualStudio.Workspace" Version="17.12.19" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Compiler\SmallBasic.Compiler.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Utilities\SmallBasic.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Menus.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DebugAdapterSource)" Condition="Exists('$(DebugAdapterSource)')">
      <Link>debugadapter\adapter.js</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Regenerate the VSIX manifest and VersionInfo.g.cs from version.json even
       when the project is built directly (VS IDE or `dotnet build`). The step is
       non-fatal so an offline build still succeeds using the committed values. -->
  <Target Name="SyncSharedVersion" BeforeTargets="BeforeBuild" Condition="Exists('$(VersionSyncScript)')">
    <Exec Command="node &quot;$(VersionSyncScript)&quot;" ContinueOnError="WarnAndContinue" StandardOutputImportance="low" />
  </Target>

  <Target Name="ValidateDebugAdapterOutput" BeforeTargets="Build">
    <Warning
      Condition="!Exists('$(DebugAdapterSource)')"
      Text="Small Basic debug adapter was not found. Run npm run build in visual_studio_code_plugin before packaging the VSIX." />
    <Warning
      Condition="!Exists('$(JavaScriptRunHostSource)')"
      Text="Small Basic JavaScript run host was not found. Run npm run build in visual_studio_code_plugin before packaging the VSIX." />
  </Target>

  <Target Name="PrepareRunHostForVsix" BeforeTargets="GetVsixSourceItems">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SmallBasic.RunHost\SmallBasic.RunHost.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);TargetFramework=net48" />

    <PropertyGroup>
      <BlazorRunHostStaging>$(MSBuildProjectDirectory)\obj\$(Configuration)\vsix\runhost\blazor\</BlazorRunHostStaging>
    </PropertyGroup>
    <RemoveDir Directories="$(BlazorRunHostStaging)" />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\SmallBasic.Blazor.RunHost\SmallBasic.Blazor.RunHost.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=net8.0;PublishDir=$(BlazorRunHostStaging)" />

    <PropertyGroup>
      <JavaScriptRunHostStaging>$(IntermediateOutputPath)vsix\runhost\javascript\smallbasic-runhost.js</JavaScriptRunHostStaging>
    </PropertyGroup>

    <MakeDir
      Directories="$([System.IO.Path]::GetDirectoryName('$(JavaScriptRunHostStaging)'))"
      Condition="Exists('$(JavaScriptRunHostSource)')" />
    <Copy
      SourceFiles="$(JavaScriptRunHostSource)"
      DestinationFiles="$(JavaScriptRunHostStaging)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(JavaScriptRunHostSource)')" />

    <ItemGroup>
      <RunHostFiles Include="$(MSBuildThisFileDirectory)..\SmallBasic.RunHost\bin\$(Configuration)\net48\**\*" />
      <BlazorRunHostFiles Include="$(BlazorRunHostStaging)**\*" />
      <Content Include="@(RunHostFiles)">
        <Link>runhost\csharp\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
      <Content Include="@(BlazorRunHostFiles)">
        <Link>runhost\blazor\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
      <Content Include="$(JavaScriptRunHostStaging)" Condition="Exists('$(JavaScriptRunHostStaging)')">
        <Link>runhost\javascript\smallbasic-runhost.js</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <!-- A Release VSIX stays as small as possible and ships no managed debug
       symbols. This drops every PDB collected into @(VSIXSourceItem): the
       RunHost/Blazor payload PDBs (staged above as linked Content items) and the
       PDBs that come along with the referenced compiler assemblies.
       IncludeDebugSymbolsInVSIXContainer only covers this project's own assembly,
       so the referenced ones need this explicit removal. The target runs after
       @(VSIXSourceItem) is complete and before it is turned into files.json, so
       the VSSDK-generated VSIX v3 manifest stays consistent. Debug builds keep
       the symbols. -->
  <Target Name="ExcludeDebugSymbolsFromVsix"
          BeforeTargets="GenerateFileManifest"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="'%(VSIXSourceItem.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
