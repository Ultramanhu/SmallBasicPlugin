<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'x86'">AnyCPU</Platform>
    <Platforms>AnyCPU</Platforms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- The .sb file icon is resolved through the WPF resource bundle
         (SmallBasic.Vsix.g.resources), so the WPF resource pipeline has to run
         even though the extension has no XAML application of its own. -->
    <UseWPF>true</UseWPF>
    <Prefer32Bit>false</Prefer32Bit>
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <!-- The experimental instance loads the extension from the deployment folder
         (the generated pkgdef registers $PackageFolder$\SmallBasic.Vsix.dll) and
         the VSSDK deploy unzips the VSIX container itself, while
         IncludeDebugSymbolsInLocalVSIXDeployment only feeds the copy-based
         deployment. The symbols therefore have to live in the container for an
         F5 build of either configuration, otherwise the deployed assembly has no
         .pdb next to it and every breakpoint in the extension stays unbound.
         Packaging (a command line build) keeps the shipped package symbol-free;
         see ExcludeDebugSymbolsFromVsix below. -->
    <IncludeDebugSymbolsInVSIXContainer Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer Condition="'$(BuildingInsideVisualStudio)' != 'true'">false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CreateVsixContainer>true</CreateVsixContainer>
    <TargetVsixContainerName>SmallBasic.Vsix.vsix</TargetVsixContainerName>
    <DeployExtension>false</DeployExtension>
    <CopyVsixManifestToOutput>true</CopyVsixManifestToOutput>
    <RootNamespace>SmallBasic.Vsix</RootNamespace>
    <AssemblyName>SmallBasic.Vsix</AssemblyName>
    <DebugAdapterSource>$(MSBuildThisFileDirectory)..\..\..\visual_studio_code_plugin\packages\smallbasic-vscode\dist\debug\adapter.js</DebugAdapterSource>
    <JavaScriptRunHostSource>$(MSBuildThisFileDirectory)..\..\..\visual_studio_code_plugin\packages\smallbasic-vscode\dist\runhost.js</JavaScriptRunHostSource>
  </PropertyGroup>

  <!-- Debug and Release are both startable from Visual Studio: the VSIX debugger
       builds the container, deploys it to the experimental instance and attaches
       the managed debugger to that instance's devenv.exe. A generic Program
       launch would only start /RootSuffix Exp and could therefore load a
       previously installed VSIX instead of the one just built, so it stays as a
       fallback behind the VSIX debugger flavor. Deployment only happens inside
       Visual Studio; the packaging scripts (dotnet build) never deploy. -->
  <PropertyGroup>
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DeployExtension>
    <DebuggerFlavor>VsixDebugger</DebuggerFlavor>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/RootSuffix Exp</StartArguments>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRootDirectory>$(MSBuildThisFileDirectory)..\..\..\</RepoRootDirectory>
    <VersionSyncScript>$(RepoRootDirectory)tools\sync-version.mjs</VersionSyncScript>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility" Version="17.14.2098" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.11.40262" ExcludeAssets="runtime" />
    <!-- The classic content-type based LSP client can coexist with the small legacy
         language service used by the native navigation bar. Visual Studio supplies
         the runtime assembly; this reference is compile-only. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.11.32" ExcludeAssets="runtime" />
    <!-- Open Folder launch-target extensibility. The assembly keeps a stable
         17.0.0.0 version and Visual Studio ships it in every installation, so
         the reference is compile-only (runtime assets excluded). -->
    <PackageReference Include="Microsoft.VisualStudio.Workspace" Version="17.12.19" ExcludeAssets="runtime" />
    <!-- Pin VSSDK BuildTools so the hybrid package produces complete VSIX v3
         metadata (manifest.json, catalog.json, extensionDir, hashes). -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- System.Windows.Threading.DispatcherTimer used by the debug inline-values adornment. -->
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Compiler\SmallBasic.Compiler.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Utilities\SmallBasic.Utilities.csproj" />
    <!-- Framework agnostic language layer: LSP models, compiler semantic mapping,
         document outline and the built-in Small Basic language server. -->
    <ProjectReference Include="..\SmallBasic.LanguageServices\SmallBasic.LanguageServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solution Explorer icon for .sb files: the Resource item packs the logo
         into the WPF resource bundle referenced by the image manifest, and the
         manifest plus the pkgdef that maps .sb to the moniker ship as VSIX
         assets. -->
    <Resource Include="Icons\SmallBasicFileIcon.png" />
    <Content Include="SmallBasicIcons.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SmallBasicIcons.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(DebugAdapterSource)" Condition="Exists('$(DebugAdapterSource)')">
      <Link>debugadapter\adapter.js</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ToolWindows\Outline\SmallBasicOutlineControl.xaml" LogicalName="SmallBasic.Vsix.ToolWindows.Outline.SmallBasicOutlineControl.xaml" />
    <Page Remove="ToolWindows\Outline\SmallBasicOutlineControl.xaml" />
  </ItemGroup>

  <Target Name="SyncSharedVersion" BeforeTargets="BeforeBuild" Condition="Exists('$(VersionSyncScript)')">
    <Exec Command="node &quot;$(VersionSyncScript)&quot;" ContinueOnError="WarnAndContinue" StandardOutputImportance="low" />
  </Target>

  <Target Name="ValidateDebugAdapterOutput" BeforeTargets="Build">
    <Warning Condition="!Exists('$(DebugAdapterSource)')" Text="Small Basic debug adapter was not found. Run npm run build in visual_studio_code_plugin before packaging the VSIX." />
    <Warning Condition="!Exists('$(JavaScriptRunHostSource)')" Text="Small Basic JavaScript run host was not found. Run npm run build in visual_studio_code_plugin before packaging the VSIX." />
  </Target>

  <Target Name="PrepareRunHostForVsix" BeforeTargets="GetVsixSourceItems">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SmallBasic.RunHost\SmallBasic.RunHost.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net48" />

    <PropertyGroup>
      <BlazorRunHostStaging>$(MSBuildProjectDirectory)\obj\$(Configuration)\vsix\runhost\blazor\</BlazorRunHostStaging>
    </PropertyGroup>
    <RemoveDir Directories="$(BlazorRunHostStaging)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\SmallBasic.Blazor.RunHost\SmallBasic.Blazor.RunHost.csproj" Targets="Publish" Properties="Configuration=$(Configuration);TargetFramework=net8.0;PublishDir=$(BlazorRunHostStaging)" />

    <PropertyGroup>
      <JavaScriptRunHostStaging>$(IntermediateOutputPath)vsix\runhost\javascript\smallbasic-runhost.js</JavaScriptRunHostStaging>
    </PropertyGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(JavaScriptRunHostStaging)'))" Condition="Exists('$(JavaScriptRunHostSource)')" />
    <Copy SourceFiles="$(JavaScriptRunHostSource)" DestinationFiles="$(JavaScriptRunHostStaging)" SkipUnchangedFiles="true" Condition="Exists('$(JavaScriptRunHostSource)')" />

    <ItemGroup>
      <RunHostFiles Include="$(MSBuildThisFileDirectory)..\SmallBasic.RunHost\bin\$(Configuration)\net48\**\*" />
      <BlazorRunHostFiles Include="$(BlazorRunHostStaging)**\*" />
      <Content Include="@(RunHostFiles)">
        <Link>runhost\csharp\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
      <Content Include="@(BlazorRunHostFiles)">
        <Link>runhost\blazor\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
      <Content Include="$(JavaScriptRunHostStaging)" Condition="Exists('$(JavaScriptRunHostStaging)')">
        <Link>runhost\javascript\smallbasic-runhost.js</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
      </Content>
    </ItemGroup>
  </Target>

  <!-- Only the packaged (command line) Release build drops the symbols: a Release
       build started from Visual Studio keeps them so the extension stays
       debuggable in the experimental instance, while build\Package-Vsix.ps1
       asserts that the shipped package contains no .pdb. -->
  <Target Name="ExcludeDebugSymbolsFromVsix" BeforeTargets="GenerateFileManifest"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingInsideVisualStudio)' != 'true'">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="'%(VSIXSourceItem.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
