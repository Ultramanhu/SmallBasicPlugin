<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the image moniker that carries the Small Basic logo. The images are
     packed into the extension assembly's WPF resource bundle
     (SmallBasic.Vsix.g.resources) by the <Resource> items in
     SmallBasic.Vsix.csproj. SmallBasicIcons.pkgdef then maps the .sb file
     extension to the moniker declared here.

     A bitmap <Source> must state its logical size (the "Manifest from Resources"
     tool emits <Size> for .png sources, either from the <name>.<width>.<height>
     file name pattern or from the actual pixel dimensions); without it the image
     service cannot pick the variant to draw and the file keeps the generic
     icon. -->
<ImageManifest xmlns="http://schemas.microsoft.com/VisualStudio/ImageManifestSchema/2014">
  <Symbols>
    <String Name="Resources" Value="/SmallBasic.Vsix;Component/Icons" />
    <Guid Name="SmallBasicImagesGuid" Value="{57c89fbb-6dd2-49b1-ad07-e02f072f65b9}" />
    <ID Name="SmallBasicFileIcon" Value="1" />
  </Symbols>
  <Images>
    <Image Guid="$(SmallBasicImagesGuid)" ID="$(SmallBasicFileIcon)">
      <Source Uri="$(Resources)/SmallBasicFileIcon.16.16.png">
        <Size Value="16" />
      </Source>
      <Source Uri="$(Resources)/SmallBasicFileIcon.32.32.png">
        <Size Value="32" />
      </Source>
    </Image>
  </Images>
  <ImageLists />
</ImageManifest>
