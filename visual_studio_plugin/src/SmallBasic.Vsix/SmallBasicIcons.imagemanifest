<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the image moniker that carries the Small Basic logo.
     SmallBasicIcons.pkgdef maps the .sb file extension to the moniker declared
     here. The image manifest points at an assembly-resource XAML surface,
     mirroring the FileIcons extension's pattern, while the XAML surface simply
     wraps the logo-derived PNG resource that ships in the extension assembly.
     Visual Studio 2026/Exp may still fail to render this custom file moniker
     in folder view, but the intended .sb association remains the Small Basic
     logo rather than a fallback built-in icon. -->
<ImageManifest xmlns="http://schemas.microsoft.com/VisualStudio/ImageManifestSchema/2014">
  <Symbols>
    <String Name="Resources" Value="/SmallBasic.Vsix;Component/Icons" />
    <Guid Name="SmallBasicImagesGuid" Value="{57c89fbb-6dd2-49b1-ad07-e02f072f65b9}" />
    <Guid Name="ImageCatalogGuid" Value="{ae27a6b0-e345-4288-96df-5eaf394ee369}" />
    <ID Name="SmallBasicFileIcon" Value="1" />
    <ID Name="SmallBasicNavigationIcons" Value="2" />
  </Symbols>
  <Images>
    <Image Guid="$(SmallBasicImagesGuid)" ID="$(SmallBasicFileIcon)" AllowColorInversion="false">
      <Source Uri="$(Resources)/SmallBasicFileIcon.xaml" />
    </Image>
  </Images>
  <ImageLists>
    <!-- Indices: main program, procedure/function, variable. -->
    <ImageList Guid="$(SmallBasicImagesGuid)" ID="$(SmallBasicNavigationIcons)">
      <ContainedImage Guid="$(ImageCatalogGuid)" ID="1913" External="true" /> <!-- Module -->
      <ContainedImage Guid="$(ImageCatalogGuid)" ID="1880" External="true" /> <!-- MethodPublic -->
      <ContainedImage Guid="$(ImageCatalogGuid)" ID="1747" External="true" /> <!-- LocalVariable -->
    </ImageList>
  </ImageLists>
</ImageManifest>
