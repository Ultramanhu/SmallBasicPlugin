<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net48 / net8.0-windows : Windows desktop hosts with WPF graphics support.
      net8.0                  : portable, text-only host (runs on Windows/Linux/macOS).
    -->
    <TargetFrameworks>net48;net8.0;net8.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net8.0-windows'">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);GRAPHICS_HOST</DefineConstants>
  </PropertyGroup>

  <!--
    Single-file sidecar publish for the Tauri desktop playground (design doc 10,
    section 18.5). The switch is scoped to this project so referenced projects
    are not affected. Staged with: dotnet publish -r RID -self-contained true
    and the global property SmallBasicStageSidecar set to true.
  -->
  <PropertyGroup Condition="'$(SmallBasicStageSidecar)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="SmallBasic" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Libraries\GraphicsWindowLibrary.cs" />
    <Compile Remove="Libraries\ShapesLibrary.cs" />
    <Compile Remove="Libraries\TurtleLibrary.cs" />
  </ItemGroup>

  <!-- net48 has no inbox System.Text.Json; the DAP debug host needs it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Compiler\SmallBasic.Compiler.csproj" />
    <ProjectReference Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Utilities\SmallBasic.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\ArrayLibrary.cs" Link="Libraries\Imported\ArrayLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\ClockLibrary.cs" Link="Libraries\Imported\ClockLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\DictionaryLibrary.cs" Link="Libraries\Imported\DictionaryLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\MathLibrary.cs" Link="Libraries\Imported\MathLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\StackLibrary.cs" Link="Libraries\Imported\StackLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\TextLibrary.cs" Link="Libraries\Imported\TextLibrary.cs" />
    <Compile Include="..\..\vendor\SmallBasicEditor\Source\SmallBasic.Editor\Libraries\TimerLibrary.cs" Link="Libraries\Imported\TimerLibrary.cs" />
  </ItemGroup>
</Project>
