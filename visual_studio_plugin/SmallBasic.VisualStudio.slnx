<Solution>
  <Folder Name="/src/">
    <Project Path="src/SmallBasic.CompiledArtifacts/SmallBasic.CompiledArtifacts.csproj" />
    <Project Path="src/SmallBasic.Compiler.Tool/SmallBasic.Compiler.Tool.csproj" />
    <Project Path="src/SmallBasic.CompiledDebugAdapter/SmallBasic.CompiledDebugAdapter.csproj" />
    <Project Path="src/SmallBasic.Vsix/SmallBasic.Vsix.csproj">
      <Deploy />
    </Project>
    <Project Path="src/SmallBasic.RunHost/SmallBasic.RunHost.csproj" />
  </Folder>
  <Folder Name="/shared/">
    <Project Path="src/SmallBasic.LanguageServices/SmallBasic.LanguageServices.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/SmallBasic.Compiler.Tests/SmallBasic.Compiler.Tests.csproj" />
    <Project Path="tests/SmallBasic.LanguageServices.Tests/SmallBasic.LanguageServices.Tests.csproj" />
  </Folder>
  <Folder Name="/vendor/">
    <!-- SmallBasic.Analyzers must stay part of the solution: every other vendor
         project references it as a Roslyn analyzer and hard-codes its output as
         ...\SmallBasic.Analyzers\bin\$(Configuration)\netstandard2.0\. A project
         that is only referenced (not listed here) is built with the solution's
         fallback Debug configuration, so a Release solution build would look for
         a Release analyzer that was never produced (CS0006). -->
    <Project Path="vendor/SmallBasicEditor/Source/SmallBasic.Analyzers/SmallBasic.Analyzers.csproj" />
    <Project Path="vendor/SmallBasicEditor/Source/SmallBasic.Compiler/SmallBasic.Compiler.csproj" />
    <Project Path="vendor/SmallBasicEditor/Source/SmallBasic.Utilities/SmallBasic.Utilities.csproj" />
  </Folder>
</Solution>
