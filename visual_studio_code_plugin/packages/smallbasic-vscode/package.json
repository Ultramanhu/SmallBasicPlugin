{
  "name": "smallbasic-tools-vsc",
  "displayName": "SmallBasic for Visual Studio Code",
  "icon": "media/icon.png",
  "description": "Microsoft SmallBasic Support for Visual Studio Code",
  "version": "0.1.2",
  "publisher": "ultramanhu",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ultramanhu/SmallBasicPlugin.git"
  },
  "keywords": [
    "SmallBasic",
    "Basic",
    "Microsoft"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": true
  },
  "categories": [
    "Programming Languages"
  ],
  "files": [
    "README.md",
    "dist/**",
    "LICENSE.txt",
    "language-configuration.json",
    "media/**",
    "runhost/**",
    "snippets/**",
    "syntaxes/**"
  ],
  "contributes": {
    "languages": [
      {
        "id": "smallbasic",
        "aliases": [
          "SmallBasic",
          "smallbasic"
        ],
        "extensions": [
          ".sb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/SmallBasic.svg",
          "dark": "./media/SmallBasic.svg"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "smallbasic"
      }
    ],
    "grammars": [
      {
        "language": "smallbasic",
        "scopeName": "source.smallbasic",
        "path": "./syntaxes/smallbasic.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "smallbasic",
        "path": "./snippets/smallbasic.json"
      }
    ],
    "commands": [
      {
        "command": "smallbasic.newFile",
        "title": "SmallBasic: New File"
      },
      {
        "command": "smallbasic.runJavaScript",
        "title": "SmallBasic: Run with JavaScript Backend",
        "icon": "$(play)"
      },
      {
        "command": "smallbasic.runCSharp",
        "title": "SmallBasic: Run with C# Backend",
        "icon": "$(play)"
      },
      {
        "command": "smallbasic.runBlazor",
        "title": "SmallBasic: Run with Blazor Backend",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "smallbasic.runJavaScript",
          "when": "resourceLangId == smallbasic",
          "group": "navigation"
        },
        {
          "command": "smallbasic.runCSharp",
          "when": "resourceLangId == smallbasic && !isWeb",
          "group": "navigation"
        },
        {
          "command": "smallbasic.runBlazor",
          "when": "resourceLangId == smallbasic && !isWeb",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "smallbasic.newFile",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "debuggers": [
      {
        "type": "smallbasic",
        "label": "SmallBasic",
        "languages": [
          "smallbasic"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the SmallBasic program.",
                "default": "${file}"
              },
              "backend": {
                "type": "string",
                "enum": [
                  "javascript",
                  "csharp",
                  "blazor"
                ],
                "description": "Backend to launch. Blazor runs text-only programs in the terminal and opens a browser only for GraphicsWindow/Shapes/Turtle programs."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Break on the first executable line."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "SmallBasic: Debug current file with JavaScript backend",
            "body": {
              "type": "smallbasic",
              "request": "launch",
              "name": "SmallBasic: Debug current file with JavaScript backend",
              "program": "${file}",
              "backend": "javascript",
              "stopOnEntry": false
            }
          },
          {
            "label": "SmallBasic: Debug current file with C# backend",
            "body": {
              "type": "smallbasic",
              "request": "launch",
              "name": "SmallBasic: Debug current file with C# backend",
              "program": "${file}",
              "backend": "csharp",
              "stopOnEntry": false
            }
          },
          {
            "label": "SmallBasic: Debug current file with Blazor backend",
            "body": {
              "type": "smallbasic",
              "request": "launch",
              "name": "SmallBasic: Debug current file with Blazor backend",
              "program": "${file}",
              "backend": "blazor",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "SmallBasic",
      "properties": {
        "smallbasic.diagnostics.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Delay before recomputing diagnostics after edits."
        },
        "smallbasic.csharp.runHostPath": {
          "type": "string",
          "default": "",
          "description": "Path to SmallBasic.RunHost.exe or SmallBasic.RunHost.dll for the C# runtime backend. If empty, the extension uses the bundled Windows or portable host."
        },
        "smallbasic.blazor.runHostPath": {
          "type": "string",
          "default": "",
          "description": "Path to SmallBasic.Blazor.RunHost.dll or its executable. If empty, the extension uses the bundled cross-platform host."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node ./scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "smallbasic-lang-core": "0.1.0"
  }
}
