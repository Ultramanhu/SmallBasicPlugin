      "  Return Whole + Rest",
      "EndFunction",
      "Answer = SplitEvenOdd(9)",
      "TextWindow.WriteLine(Answer)"
    ],
    "stdout": [
      "5"
    ],
    "globals": {
      "Answer": "5"
    }
