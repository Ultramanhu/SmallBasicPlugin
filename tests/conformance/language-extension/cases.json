  {
    "name": "Break exits the innermost While loop",
    "source": [
      "While \"True\"",
      "  TextWindow.WriteLine(\"before\")",
      "  Break",
      "  TextWindow.WriteLine(\"after\")",
      "EndWhile",
      "TextWindow.WriteLine(\"done\")"
    ],
    "stdout": [
      "before",
      "done"
    ]
  },
  {
    "name": "Continue skips the rest of the While body",
    "source": [
      "I = 0",
      "Sum = 0",
      "While I < 5",
      "  I = I + 1",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Sum = Sum + I",
      "EndWhile",
      "TextWindow.WriteLine(Sum)"
    ],
    "stdout": [
      "12"
    ],
    "globals": {
      "Sum": "12",
      "I": "5"
    }
  },
  {
    "name": "Break in a For loop skips the increment",
    "source": [
      "For I = 1 To 10",
      "  If I = 4 Then",
      "    Break",
      "  EndIf",
      "EndFor",
      "TextWindow.WriteLine(I)"
    ],
    "stdout": [
      "4"
    ],
    "globals": {
      "I": "4"
    }
  },
  {
    "name": "Continue in a For loop still runs the increment",
    "source": [
      "Sum = 0",
      "For I = 1 To 5",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Sum = Sum + I",
      "EndFor",
      "TextWindow.WriteLine(Sum)",
      "TextWindow.WriteLine(I)"
    ],
    "stdout": [
      "12",
      "6"
    ],
    "globals": {
      "Sum": "12",
      "I": "6"
    }
  },
  {
    "name": "Continue in a For loop with a negative Step",
    "source": [
      "Out = 0",
      "For I = 5 To 1 Step -1",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Out = Out * 10 + I",
      "EndFor",
      "TextWindow.WriteLine(Out)"
    ],
    "stdout": [
      "5421"
    ],
    "globals": {
      "Out": "5421",
      "I": "0"
    }
  },
  {
    "name": "Continue in a For loop with an explicit positive Step",
    "source": [
      "Out = 0",
      "For I = 1 To 7 Step 2",
      "  If I = 3 Then",
      "    Continue",
      "  EndIf",
      "  Out = Out * 10 + I",
      "EndFor",
      "TextWindow.WriteLine(Out)"
    ],
    "stdout": [
      "157"
    ],
    "globals": {
      "Out": "157",
      "I": "9"
    }
  },
  {
    "name": "Break and Continue only affect the innermost loop",
    "source": [
      "Out = 0",
      "For I = 1 To 2",
      "  For J = 1 To 3",
      "    If J = 2 Then",
      "      Continue",
      "    EndIf",
      "    If J = 3 Then",
      "      Break",
      "    EndIf",
      "    Out = Out + I * 10 + J",
      "  EndFor",
      "  Out = Out + 1000",
      "EndFor",
      "TextWindow.WriteLine(Out)"
    ],
    "stdout": [
      "2032"
    ],
    "globals": {
      "Out": "2032",
      "I": "3",
      "J": "3"
    }
  },
  {
    "name": "Break inside a Function loop",
    "source": [
      "Function SumUntil(Stop)",
      "  Dim Total",
      "  Total = 0",
      "  For I = 1 To 10",
      "    If I = Stop Then",
      "      Break",
      "    EndIf",
      "    Total = Total + I",
      "  EndFor",
      "  Return Total",
      "EndFunction",
      "TextWindow.WriteLine(SumUntil(4))"
    ],
    "stdout": [
      "6"
    ],
    "globals": {
      "I": "4"
    }
  },
