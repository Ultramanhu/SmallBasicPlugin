  {
    "name": "Math.Div and Math.Mod match the operators",
    "source": [
      "A = Math.Div(7, 2)",
      "B = Math.Div(-7, 2)",
      "C = Math.Mod(7, 2)",
      "D = Math.Mod(-7, 2)",
      "E = Math.Div(9, 0)",
      "F = Math.Mod(9, 0)",
      "G = Math.Mod(Math.Div(17, 5), 2)",
      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(B)",
      "TextWindow.WriteLine(C)",
      "TextWindow.WriteLine(D)",
      "TextWindow.WriteLine(E)",
      "TextWindow.WriteLine(F)",
      "TextWindow.WriteLine(G)"
    ],
    "stdout": [
      "3",
      "-3",
      "1",
      "-1",
      "0",
      "0",
      "1"
    ],
    "globals": {
      "A": "3",
      "B": "-3",
      "C": "1",
      "D": "-1",
      "E": "0",
      "F": "0",
      "G": "1"
    }
  },
  {
    "name": "div and mod work inside functions with locals",
    "source": [
