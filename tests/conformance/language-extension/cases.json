  {
    "name": "forward mutual function calls",
    "source": [
      "Function IsEven(N)",
      "  If N = 0 Then",
      "    Return \"True\"",
      "  EndIf",
      "  Return IsOdd(N - 1)",
      "EndFunction",
      "Function IsOdd(N)",
      "  If N = 0 Then",
      "    Return \"False\"",
      "  EndIf",
      "  Return IsEven(N - 1)",
      "EndFunction",
      "Answer = IsEven(8)"
    ],
    "stdout": [],
    "globals": {
      "Answer": "True"
    }
  },
