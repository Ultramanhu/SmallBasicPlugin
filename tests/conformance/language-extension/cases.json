      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(\"after\")"
    ],
    "stdout": [
      "0",
      "after"
    ],
    "globals": {
      "A": "0"
    }
  },
  {
    "name": "modulo keeps the sign of the dividend",
    "source": [
      "A = 7 Mod 2",
      "B = -7 Mod 2",
      "C = 7.5 Mod 2",
      "D = 8 Mod 2",
      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(B)",
      "TextWindow.WriteLine(C)",
      "TextWindow.WriteLine(D)"
    ],
    "stdout": [
      "1",
      "-1",
      "1.5",
      "0"
    ],
    "globals": {
      "A": "1",
      "B": "-1",
      "C": "1.5",
      "D": "0"
    }
  },
  {
    "name": "modulo by zero yields zero and keeps running",
    "source": [
      "A = 4 Mod 0",
      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(\"after\")"
    ],
    "stdout": [
      "0",
      "after"
    ],
    "globals": {
      "A": "0"
    }
  },
  {
    "name": "arithmetic operators follow the Visual Basic precedence ladder",
    "source": [
      "A = 6 Mod 4 * 2",
      "B = 7 \\ 2 * 3",
      "C = 12 \\ 4 Mod 3",
      "D = 8 - 3 Mod 2",
      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(B)",
      "TextWindow.WriteLine(C)",
      "TextWindow.WriteLine(D)"
    ],
    "stdout": [
      "6",
      "1",
      "0",
      "7"
    ],
    "globals": {
      "A": "6",
      "B": "1",
      "C": "0",
      "D": "7"
    }
  },
