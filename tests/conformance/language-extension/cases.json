  {
    "name": "integer division truncates toward zero",
    "source": [
      "A = 7 \\ 2",
      "B = -7 \\ 2",
      "C = 8 \\ 2",
      "TextWindow.WriteLine(A)",
      "TextWindow.WriteLine(B)",
      "TextWindow.WriteLine(C)"
    ],
    "stdout": [
      "3",
      "-3",
      "4"
    ],
    "globals": {
      "A": "3",
      "B": "-3",
      "C": "4"
    }
  },
  {
    "name": "integer division on fractional operands truncates the real quotient",
    "source": [
      "A = 7.9 \\ 2.9",
      "TextWindow.WriteLine(A)"
    ],
    "stdout": [
      "2"
    ],
    "globals": {
      "A": "2"
    }
  },
  {
    "name": "integer division by zero yields zero and keeps running",
    "source": [
