      "Answer": "42"
    }
  },
  {
    "name": "no-parameter fallthrough returns empty",
    "source": [
      "Function Empty()",
      "  Dim Local",
      "  Local = 1",
      "EndFunction",
      "Answer = Empty()",
      "TextWindow.WriteLine(\"[\" + Answer + \"]\")"
    ],
    "stdout": [
      "[]"
    ],
    "globals": {
      "Answer": ""
    }
  },
