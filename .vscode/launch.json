{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "smallbasic",
            "request": "launch",
            "name": "SmallBasic: Debug current file with Blazor backend",
            "program": "${file}",   
            "backend": "blazor",
            "stopOnEntry": false
        },
        {
            "type": "smallbasic",
            "request": "launch",
            "name": "SmallBasic: Debug current file with C# backend",
            "program": "${file}",
            "backend": "csharp",
            "stopOnEntry": false
        },
        {
            "type": "smallbasic",
            "request": "launch",
            "name": "SmallBasic: Debug current file with JavaScript backend",
            "program": "${file}",
            "backend": "javascript",
            "stopOnEntry": false
        },
        {
            // 前置：cd visual_studio_code_plugin; npm install; npm run build; npm run stage:blazor -w smallbasic-tools-vsc
            "name": "SmallBasic Web Extension (VS Code Web host, no worker debugging)",
            "type": "pwa-extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentKind=web",
                "--extensionDevelopmentPath=${workspaceFolder}/visual_studio_code_plugin/packages/smallbasic-vscode",
                "${workspaceFolder}/test"
            ]
        },
        {
            // 前置：cd visual_studio_code_plugin; npm install; npm run build
            "name": "SmallBasic Extension (VS Code desktop host, non-Web)",
            "type": "pwa-extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/visual_studio_code_plugin/packages/smallbasic-vscode",
                "${workspaceFolder}/test"
            ],
            "outFiles": [
                "${workspaceFolder}/visual_studio_code_plugin/packages/smallbasic-vscode/dist/**/*.js"
            ]
            // 若要同时跟进 RunHost / 调试适配器这类子进程，追加：
            // "autoAttachChildProcesses": true
        }
    ]
}