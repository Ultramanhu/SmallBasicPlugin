TextWindow.WriteLine("Hello, World!")

a1 = 1
a2 = a1 + ""
TextWindow.WriteLine(a2)

s1 = "3"
s2 = s1 * 1
TextWindow.WriteLine(s2)

i = 10

Sub MySub(i)
	Dim j
	TextWindow.WriteLine("MySub:" + i)
	j = i + 1
	If j < 10 Then
		MySub(j)
	EndIf
EndSub

MySub(0)

Function MyFunc(i)
	Dim j
	TextWindow.WriteLine("MyFunc:" + i)
	j = i + 1
	If j < 10 Then
		Return MyFunc(j)
	EndIf
	Return i
EndFunction

Ret = MyFunc(0)
TextWindow.WriteLine("MyFunc Ret:" + Ret)
