# VS files
.vs/
.vscode/*
!.vscode/launch.json
*.csproj.user
.artifacts
.vscode-test-web/

# ai file
.playwright-cli
.playwright-mcp
.tmp
.kilo
.zcodeignore
.codebuddy

# debug
*.log
.cache
.trace
.network
visual_studio_code_plugin/tests/webview/artifacts

# Output files
bin
obj
node_modules
wwwroot
# The Blazor client's source wwwroot holds the shell page of the web RunHost
# (index.html, app.css, shell.js, serve.mjs), so it is tracked despite the
# generated-site rule above. Everything published below wwwroot stays ignored.
!visual_studio_plugin/src/SmallBasic.Blazor.Client/wwwroot
!visual_studio_plugin/src/SmallBasic.Blazor.Client/wwwroot/**
out
visual_studio_code_plugin/packages/smallbasic-vscode/runhost/
.gitignore


# Tauri local playground (generated staging).
runhost/playground/bundles/
!runhost/playground/bin/
!runhost/playground/bundles/*.msi

# Build inputs and intermediates of the desktop shell (never shipped). The Tauri
# package lives at the repository root (smallbasic_playground_app) so its Rust
# target/ (several GB), the mobile scaffolding under gen/ and the staging obj/
# stay out of the VS Code workspace tree and out of the repository.
smallbasic_playground_app/dist/
smallbasic_playground_app/src-tauri/target/
smallbasic_playground_app/src-tauri/gen/
smallbasic_playground_app/src-tauri/keystore/
